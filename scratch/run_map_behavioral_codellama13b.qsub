#!/bin/bash -l
# Behavioral <-> circuit mapping for CodeLlama-13b on one single-PUT data file.
#
#   qsub scratch/run_map_behavioral_codellama13b.qsub <seed|orig> [num_samples]
#
#   orig    -> data/boxes_altAlways_1put_moreObj_noEmpty (the Sep 2026 file, no seed suffix)
#   1..5    -> data/boxes_altAlways_1put_moreObj_noEmpty_seed<N>
#
# Output: outputs/behavioral_map/codellama-13b/<seed|orig>/{map_*.jsonl, summary_*.json}
# Log:    logs/map_behavioral_<seed|orig>.<jobid>.log
# Submit from the repository root; logs/ must exist. Same environment as the circuit eval jobs.
#$ -P tin-lab
#$ -l h_rt=2:00:00
#$ -N map_behavioral_codellama13b
#$ -j y
#$ -o logs/$JOB_NAME.$JOB_ID.log
#$ -pe omp 2
#$ -l gpus=1
#$ -l gpu_c=8.5
#$ -l gpu_memory=47G

SEED="${1:?usage: qsub scratch/run_map_behavioral_codellama13b.qsub <seed|orig> [num_samples]}"
N="${2:-2000}"
ROOT=$(pwd)
MODEL="codellama/CodeLlama-13b-hf"

if [ "$SEED" = "orig" ]; then
  DATAFILE="${ROOT}/data/boxes_altAlways_1put_moreObj_noEmpty/train-t5.jsonl"
else
  DATAFILE="${ROOT}/data/boxes_altAlways_1put_moreObj_noEmpty_seed${SEED}/train-t5.jsonl"
fi
OUT_DIR="${ROOT}/outputs/behavioral_map/codellama-13b/${SEED}"
LOG="${ROOT}/logs/map_behavioral_${SEED}.${JOB_ID}.log"

echo "=========================================================="
echo "Start date   : $(date)"
echo "Job          : $JOB_NAME  $JOB_ID   host $(hostname)"
echo "Seed         : $SEED   num_samples: $N"
echo "Data file    : $DATAFILE"
echo "Output dir   : $OUT_DIR"
echo "=========================================================="
nvidia-smi --query-gpu=name,memory.total --format=csv
[ -f "$DATAFILE" ] || { echo "missing data file: $DATAFILE"; exit 1; }
echo "Data md5     : $(md5sum "$DATAFILE" | cut -d' ' -f1)"

module load miniconda
conda activate /projectnb/tin-lab/yuluq/nnsight_env_fresh
export WANDB_MODE=disabled
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

cd "${ROOT}" || exit 1
python scratch/map_behavioral_to_circuit.py \
  --datafile "$DATAFILE" \
  --model "$MODEL" \
  --num_samples "$N" \
  --batch_size 16 \
  --load_in_8bit \
  --out_dir "$OUT_DIR" \
  2>&1 | tee "$LOG"

echo "=========================================================="
echo "End date     : $(date)"
echo "Result log   : $LOG"
echo "=========================================================="
