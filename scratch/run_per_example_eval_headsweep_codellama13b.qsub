#!/bin/bash -l
# Head-count sweep for the DESCRIBE circuits (CodeLlama-13b, single-PUT), evaluated per example on the
# same fixed 150-example set as run_per_example_eval_codellama13b.qsub (standard rule: non-vital positions ablated).
#
#   qsub -P ivc-ml -q ivcbuyin scratch/run_per_example_eval_headsweep_codellama13b.qsub
#
# For orig and seed4 DESCRIBE score files:
#   uniform k per group  : k = 10, 20, 40, 80, 160, 320 (capped at the number of negative-score heads in each group)
#   one group expanded   : that group at 160, the other three at their knee sizes
#   all negative heads   : every head with a negative path-patching score, per group (upper bound of this ranking)
# Knee circuits (orig 31/15/15/9, seed4 76/36/25/12), full model and the two sanity conditions are rerun as anchors.
# Output: outputs/per_example_eval/codellama-13b_headsweep/{per_example.jsonl, summary.json}
# Log:    logs/per_example_eval_headsweep.<jobid>.log      Submit from the repository root; logs/ must exist.
#$ -P tin-lab
#$ -l h_rt=3:00:00
#$ -N per_example_eval_headsweep_codellama13b
#$ -j y
#$ -o logs/$JOB_NAME.$JOB_ID.log
#$ -pe omp 2
#$ -l gpus=1
#$ -l gpu_c=8.0
#$ -l gpu_memory=47G

ROOT=$(pwd)
MODEL="codellama/CodeLlama-13b-hf"
MODEL_NAME="codellama-13b"
DATAFILE="${ROOT}/data/boxes_altAlways_1put_moreObj_noEmpty/train-t5.jsonl"
MAP_JSONL="${ROOT}/outputs/behavioral_map/${MODEL_NAME}/orig/map_CodeLlama-13b-hf_8bit_boxes_altAlways_1put_moreObj_noEmpty_n2000.jsonl"
CIRCUIT_ROOT="${ROOT}/outputs/nnsight_patch_1put/${MODEL_NAME}"
MEAN_CACHE="${CIRCUIT_ROOT}/logp_lastObjOnly/n200"
OUT_DIR="${ROOT}/outputs/per_example_eval/${MODEL_NAME}_headsweep"
LOG="${ROOT}/logs/per_example_eval_headsweep.${JOB_ID}.log"

echo "=========================================================="
echo "Start date   : $(date)"
echo "Job          : $JOB_NAME  $JOB_ID   host $(hostname)"
echo "Data file    : $DATAFILE"
echo "Map jsonl    : $MAP_JSONL"
echo "Mean cache   : $MEAN_CACHE/mean_activations.pkl"
echo "Output dir   : $OUT_DIR"
echo "=========================================================="
nvidia-smi --query-gpu=name,memory.total --format=csv
for f in "$DATAFILE" "$MAP_JSONL" "$MEAN_CACHE/mean_activations.pkl"; do [ -f "$f" ] || { echo "missing $f"; exit 1; }; done
for d in logp_notLastObj logp_lastObjOnly seed4/logp_notLastObj seed4/logp_lastObjOnly; do for g in A B C D; do
  [ -f "$CIRCUIT_ROOT/$d/n200/pp_group$g.npy" ] || { echo "missing $CIRCUIT_ROOT/$d/n200/pp_group$g.npy"; exit 1; }
done; done
echo "Data md5     : $(md5sum "$DATAFILE" | cut -d' ' -f1)"
echo "Cache md5    : $(md5sum "$MEAN_CACHE/mean_activations.pkl" | cut -d' ' -f1)"

module load miniconda
conda activate /projectnb/tin-lab/yuluq/nnsight_env_fresh
export WANDB_MODE=disabled
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
mkdir -p "$OUT_DIR"

cd "${ROOT}" || exit 1
python scratch/per_example_circuit_eval.py \
  --model "$MODEL" \
  --datafile "$DATAFILE" \
  --map_jsonl "$MAP_JSONL" \
  --batch_size 4 \
  --num_samples 2000 \
  --ops_order "put" \
  --query_ops_order "put" \
  --counterfactual_format "rand_obj_rand_query_id" \
  --num_query_object 2 \
  --sort_query_objects \
  --load_in_8bit \
  --mean_activation_cache_path "$MEAN_CACHE" \
  --circuit "orig_describe=${CIRCUIT_ROOT}/logp_notLastObj/n200" \
  --circuit "seed4_describe=${CIRCUIT_ROOT}/seed4/logp_notLastObj/n200" \
  --topk "orig_desc_k10=orig_describe:10,10,10,10" \
  --topk "orig_desc_k20=orig_describe:20,20,20,20" \
  --topk "orig_desc_k40=orig_describe:40,40,40,40" \
  --topk "orig_desc_k80=orig_describe:80,80,80,80" \
  --topk "orig_desc_k160=orig_describe:160,160,160,160" \
  --topk "orig_desc_k320=orig_describe:320,320,320,320" \
  --topk "orig_desc_A160=orig_describe:160,15,15,9" \
  --topk "orig_desc_B160=orig_describe:31,160,15,9" \
  --topk "orig_desc_C160=orig_describe:31,15,160,9" \
  --topk "orig_desc_D160=orig_describe:31,15,15,160" \
  --topk "orig_desc_allneg=orig_describe:9999,9999,9999,9999" \
  --topk "seed4_desc_k10=seed4_describe:10,10,10,10" \
  --topk "seed4_desc_k20=seed4_describe:20,20,20,20" \
  --topk "seed4_desc_k40=seed4_describe:40,40,40,40" \
  --topk "seed4_desc_k80=seed4_describe:80,80,80,80" \
  --topk "seed4_desc_k160=seed4_describe:160,160,160,160" \
  --topk "seed4_desc_k320=seed4_describe:320,320,320,320" \
  --topk "seed4_desc_A160=seed4_describe:160,36,25,12" \
  --topk "seed4_desc_B160=seed4_describe:76,160,25,12" \
  --topk "seed4_desc_C160=seed4_describe:76,36,160,12" \
  --topk "seed4_desc_D160=seed4_describe:76,36,25,160" \
  --topk "seed4_desc_allneg=seed4_describe:9999,9999,9999,9999" \
  --fixed_start_rank 1000 --n_fixed 150 --n_repro 100 \
  --out_dir "$OUT_DIR" \
  2>&1 | tee "$LOG"

echo "=========================================================="
echo "End date     : $(date)"
echo "Result log   : $LOG"
echo "=========================================================="
