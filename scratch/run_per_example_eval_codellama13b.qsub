#!/bin/bash -l
# Per-example circuit evaluation on a fixed evaluation set, CodeLlama-13b, single-PUT task.
#
#   qsub -P ivc-ml -q ivcbuyin scratch/run_per_example_eval_codellama13b.qsub
#
# Fixed set : first 150 first-token-correct candidates of the orig data file with candidate rank >= 1000
#             (disjoint from every run's discovery (<=208) and mean-activation (<=528) candidates).
# Repro set : the first 100 unfiltered candidates (what eval_circuits.py evaluated on Sep 17).
# Mean table: the orig run's mean_activations.pkl, shared by every condition.
# Circuits  : orig and seed4, DESCRIBE and PUT (knee selection, identical to the eval logs),
#             plus size-matched variants and random circuits of matching size.
# Output: outputs/per_example_eval/codellama-13b/{per_example.jsonl, summary.json}
# Log:    logs/per_example_eval.<jobid>.log      Submit from the repository root; logs/ must exist.
#$ -P tin-lab
#$ -l h_rt=2:00:00
#$ -N per_example_eval_codellama13b
#$ -j y
#$ -o logs/$JOB_NAME.$JOB_ID.log
#$ -pe omp 2
#$ -l gpus=1
#$ -l gpu_c=8.0
#$ -l gpu_memory=47G

ROOT=$(pwd)
MODEL="codellama/CodeLlama-13b-hf"
MODEL_NAME="codellama-13b"
DATAFILE="${ROOT}/data/boxes_altAlways_1put_moreObj_noEmpty/train-t5.jsonl"
MAP_JSONL="${ROOT}/outputs/behavioral_map/${MODEL_NAME}/orig/map_CodeLlama-13b-hf_8bit_boxes_altAlways_1put_moreObj_noEmpty_n2000.jsonl"
CIRCUIT_ROOT="${ROOT}/outputs/nnsight_patch_1put/${MODEL_NAME}"
MEAN_CACHE="${CIRCUIT_ROOT}/logp_lastObjOnly/n200"
OUT_DIR="${ROOT}/outputs/per_example_eval/${MODEL_NAME}"
LOG="${ROOT}/logs/per_example_eval.${JOB_ID}.log"

echo "=========================================================="
echo "Start date   : $(date)"
echo "Job          : $JOB_NAME  $JOB_ID   host $(hostname)"
echo "Data file    : $DATAFILE"
echo "Map jsonl    : $MAP_JSONL"
echo "Mean cache   : $MEAN_CACHE/mean_activations.pkl"
echo "Output dir   : $OUT_DIR"
echo "=========================================================="
nvidia-smi --query-gpu=name,memory.total --format=csv
for f in "$DATAFILE" "$MAP_JSONL" "$MEAN_CACHE/mean_activations.pkl"; do [ -f "$f" ] || { echo "missing $f"; exit 1; }; done
for d in logp_notLastObj logp_lastObjOnly seed4/logp_notLastObj seed4/logp_lastObjOnly; do for g in A B C D; do
  [ -f "$CIRCUIT_ROOT/$d/n200/pp_group$g.npy" ] || { echo "missing $CIRCUIT_ROOT/$d/n200/pp_group$g.npy"; exit 1; }
done; done
echo "Data md5     : $(md5sum "$DATAFILE" | cut -d' ' -f1)"
echo "Cache md5    : $(md5sum "$MEAN_CACHE/mean_activations.pkl" | cut -d' ' -f1)"

module load miniconda
conda activate /projectnb/tin-lab/yuluq/nnsight_env_fresh
export WANDB_MODE=disabled
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
mkdir -p "$OUT_DIR"

cd "${ROOT}" || exit 1
python scratch/per_example_circuit_eval.py \
  --model "$MODEL" \
  --datafile "$DATAFILE" \
  --map_jsonl "$MAP_JSONL" \
  --batch_size 4 \
  --num_samples 2000 \
  --ops_order "put" \
  --query_ops_order "put" \
  --counterfactual_format "rand_obj_rand_query_id" \
  --num_query_object 2 \
  --sort_query_objects \
  --load_in_8bit \
  --mean_activation_cache_path "$MEAN_CACHE" \
  --circuit "orig_describe=${CIRCUIT_ROOT}/logp_notLastObj/n200" \
  --circuit "orig_put=${CIRCUIT_ROOT}/logp_lastObjOnly/n200" \
  --circuit "seed4_describe=${CIRCUIT_ROOT}/seed4/logp_notLastObj/n200" \
  --circuit "seed4_put=${CIRCUIT_ROOT}/seed4/logp_lastObjOnly/n200" \
  --size_match "seed4_describe_at_orig_sizes=seed4_describe:orig_describe" \
  --size_match "orig_describe_at_seed4_sizes=orig_describe:seed4_describe" \
  --random_like "orig_describe:3" \
  --random_like "seed4_describe:2" \
  --fixed_start_rank 1000 --n_fixed 150 --n_repro 100 \
  --out_dir "$OUT_DIR" \
  2>&1 | tee "$LOG"

echo "=========================================================="
echo "End date     : $(date)"
echo "Result log   : $LOG"
echo "=========================================================="
